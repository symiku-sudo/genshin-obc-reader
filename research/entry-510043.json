rial-wrap\\\"><span class=\\\"name\\\">面粉</span></span><span class=\\\"amount\\\">*2</span></a></span><span class=\\\"custom-entry-wrapper\\\" data-entry-id=\\\"774\\\" data-entry-ratio=\\\"small\\\" data-entry-img=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/25/24077343/5a8ea094c58d4768c925034cdd21dc99_5938862530011803178.png\\\" data-entry-name=\\\"黄油\\\" data-entry-amount=\\\"2\\\" data-entry-link=\\\"/ys/obc/content/774/detail?bbs_presentation_style=no_header\\\" data-entry-status=\\\"Online\\\" data-updated=\\\"0\\\"><a href=\\\"/ys/obc/content/774/detail?bbs_presentation_style=no_header\\\" target=\\\"_blank\\\" class=\\\"entry-material-box entry-material-small\\\"><img class=\\\"image\\\" src=\\\"https://act-upload.mihoyo.com/ys-obc/2023/10/25/24077343/5a8ea094c58d4768c925034cdd21dc99_5938862530011803178.png\\\"><span class=\\\"entry-material-wrap\\\"><span class=\\\"name\\\">黄油</span></span><span class=\\\"amount\\\">*2</span></a></span></p>\"},\"attr\":[{\"key\":\"描述\",\"value\":[\"<p>模仿望宵饼做的新型点心。仙茗的微苦先从舌根慢慢洇开，再品味到深处沉甸甸的甘，最后收束在一缕近乎木质的清幽尾韵里，仿佛能闻到远远飘来的炒茶香气。真不愧是两位大厨出品的配方!</p>\"]},{\"key\":\"使用效果\",\"value\":[\"<p>队伍中所有角色攻击力提高320点，暴击率提升10%，持续300秒。多人游戏时，仅对自己的角色生效。</p>\"]},{\"key\":\"获得方式\",\"value\":[\"<p>完成7.1版本活动： 银翎溯月，玄鸟结磷 获得。</p>\"]},{\"key\":\"食谱获得\",\"value\":[\"<p>完美烹饪仙茗酥</p>\"]}]}\n", "style": ""}], "id": "1172", "is_customize_name": true, "is_abstract": false, "is_show_switch": false, "switch": false, "desc": "", "repeated": false, "is_submodule": false, "origin_module_id": "0", "without_border": false, "can_delete": false, "is_hidden": false, "rich_text_editing": false}, {"name": "", "is_poped": false, "components": [{"component_id": "collapse_panel", "layout": "", "data": "{\"rich_text\":\"<p></p>\",\"switch\":true,\"is_show_switch\":true,\"without_border\":false}\n", "style": ""}], "id": "5893", "is_customize_name": true, "is_abstract": false, "is_show_switch": true, "switch": true, "desc": "", "repeated": false, "is_submodule": false, "origin_mo