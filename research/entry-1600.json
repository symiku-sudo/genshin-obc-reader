      "name": "悠古的磐岩",
      "desc": "悠古的磐岩",
      "icon_url": "https://uploadstatic.mihoyo.com/ys-obc/2021/02/16/20738632/ed34a7c93f17c00551bce08c244e15cc_3795918138643596581.png",
